{
  "name": "@uniformdev/component-starter-kit",
  "version": "6.1.37",
  "private": true,
  "engines": {
    "node": ">22.0.0 <24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "run-s pull:dex apply:dex pull:locales next:dev",
    "build": "run-s pull:locales pull:dex apply:dex next:build",
    "start": "next start",
    "dev:watch": "cross-env WATCH=true run-s pull:dex apply:dex next:dev",
    "next:dev": "next dev",
    "next:build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "init": "run-s uniform:push uniform:publish",
    "init:simple": "run-s uniform:simple:push uniform:publish",
    "component:extract": "csk-components extract",
    "pull:dex": "design-extensions-tools pull",
    "apply:dex": "design-extensions-tools apply",
    "push:dex": "design-extensions-tools push",
    "pull:locales": "csk-cli pull -l",
    "pull:content": "uniform sync pull",
    "push:content": "uniform sync push",
    "uniform:pull": "run-s pull:dex apply:dex pull:content",
    "uniform:push": "run-s push:dex push:content",
    "uniform:publish": "uniform context manifest publish"
  },
  "dependencies": {
    "@uniformdev/canvas-next": "^20.32.2",
    "@uniformdev/canvas-react": "^20.32.2",
    "@uniformdev/context-next": "^20.32.2",
    "@uniformdev/csk-components": "file:./uniformdev-csk-components-pages-router.tgz",
    "@uniformdev/design-extensions-tools": "file:./uniformdev-design-extensions-tools-pages-router.tgz",
    "google-map-react": "^2.2.5",
    "next": "^15.5.4",
    "next-transpile-modules": "^10.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "npm-run-all": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@tailwindcss/typography": "^0.5.16",
    "@types/google-map-react": "^2.1.10",
    "@types/node": "^20.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@uniformdev/cli": "^20.32.2",
    "@uniformdev/csk-cli": "file:./uniformdev-csk-cli-pages-router.tgz",
    "cross-env": "^7.0.3",
    "eslint": "^9.31.0",
    "eslint-config-next": "^15.5.4",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.3",
    "postcss": "^8.5.6",
    "prettier": "3.5.2",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.7.3"
  }
}